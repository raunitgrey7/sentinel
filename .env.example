# Copy to .env. Every value has a safe local default; nothing here is required for `sentinel dev`.

# --- runtime ---------------------------------------------------------------------------
SENTINEL_ENV=dev                      # dev | test | prod
SENTINEL_LOG_LEVEL=INFO
SENTINEL_LOG_JSON=false
SENTINEL_CORS_ORIGINS=http://localhost:3000

# --- persistence (SQLite by default; PostgreSQL in compose) -----------------------------
# SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
# SENTINEL_REDIS_URL=redis://localhost:6379/0     # unset → in-process queue + memory rate limiter

# --- security (CHANGE IN PRODUCTION) --------------------------------------------------------
SENTINEL_SECRET_KEY=dev-only-change-me-please-0123456789abcdef
SENTINEL_BOOTSTRAP_ADMIN_EMAIL=admin@sentinel.local
SENTINEL_BOOTSTRAP_ADMIN_PASSWORD=admin12345
SENTINEL_BOOTSTRAP_INGEST_KEY=dev-ingest-key       # API key the simulator / collectors use to push telemetry
SENTINEL_JWT_TTL_MINUTES=720
SENTINEL_RATE_LIMIT_PER_MINUTE=600

# --- AI (local only; no paid APIs) ------------------------------------------------------------
SENTINEL_LLM_PROVIDER=none            # none (deterministic narrator) | ollama
SENTINEL_OLLAMA_BASE_URL=http://127.0.0.1:11434
SENTINEL_OLLAMA_MODEL=qwen2.5:3b            # qwen2.5:7b if you have a GPU or >24 GB RAM
SENTINEL_OLLAMA_EMBED_MODEL=nomic-embed-text
SENTINEL_LLM_TIMEOUT_S=90

# --- detection / investigation ----------------------------------------------------------------
SENTINEL_DETECTOR_INTERVAL_S=10
SENTINEL_LOW_CONFIDENCE_THRESHOLD=0.55
SENTINEL_AUTO_INVESTIGATE=true
SENTINEL_TELEMETRY_RETENTION_HOURS=48

# --- simulator ----------------------------------------------------------------------------------
SENTINEL_SIMULATOR_URL=http://localhost:9000
SIM_SENTINEL_URL=http://localhost:8000
SIM_INGEST_KEY=dev-ingest-key
SIM_TRAFFIC_RPS=12
