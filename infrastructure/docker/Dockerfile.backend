# Sentinel backend image — serves the API, the worker and the simulator (select via CMD).
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 UV_SYSTEM_PYTHON=1
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv
WORKDIR /app
COPY pyproject.toml uv.lock* README.md ./
COPY backend ./backend
COPY simulator ./simulator
RUN uv pip install --system --no-cache .
RUN useradd -r -u 10001 sentinel && mkdir -p /app/data && chown -R sentinel /app
USER sentinel
ENV SENTINEL_API_HOST=0.0.0.0 SENTINEL_API_PORT=8000
EXPOSE 8000 9000-9007
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD curl -fsS http://localhost:${SENTINEL_API_PORT}/health || exit 1
CMD ["sentinel", "api"]
